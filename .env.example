# ═══════════════════════════════════════════════════════════════════════════
# Fintegrity — environment variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to git. Real secrets never go in NEXT_PUBLIC_ vars.
# ═══════════════════════════════════════════════════════════════════════════

# ── Payload CMS ─────────────────────────────────────────────────────────────

# PostgreSQL connection string
# Dev / staging: Neon free tier  →  https://console.neon.tech
# Production target: AWS Aurora PostgreSQL (af-south-1) — swap the string only
DATABASE_URI=postgresql://username:password@host.neon.tech/dbname?sslmode=require

# Payload secret — must be at least 32 random characters
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=replace_with_64_hex_chars_min_32

# ── Cloudflare R2 media storage ─────────────────────────────────────────────
# Phase 1: leave blank to use local filesystem for uploads
# Phase 3: fill in after creating the bucket (see Phase 3 guide)

# R2 S3-compatible endpoint: https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com

# Bucket name (create at dash.cloudflare.com → R2)
R2_BUCKET=fintegrity-media

# R2 API token — scope: Object Read & Write on this bucket
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# ── Server / deployment URL ──────────────────────────────────────────────────
# NEXT_PUBLIC_ prefix is safe here — this is just the origin, not a secret.
# Dev:        http://localhost:3000
# Staging:    https://your-app.railway.app  (or Render URL)
# Production: https://www.getfintegrity.com
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ── Analytics (already wired in source — not managed by Payload) ────────────
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
NEXT_PUBLIC_MIXPANEL_TOKEN=your_mixpanel_token
NEXT_PUBLIC_MIXPANEL_API_HOST=https://api-eu.mixpanel.com

# ── HubSpot demo form (server-side only) ────────────────────────────────────
NEXT_PUBLIC_HUBSPOT_PORTAL_ID=your_portal_id
NEXT_PUBLIC_HUBSPOT_FORM_ID=your_form_guid
HUBSPOT_PRIVATE_TOKEN=your_hubspot_private_app_token
